# ============================================================
# farmpick 환경 변수 예시 (로컬 / Netlify / Render 구분)
# ============================================================

# ---------- 공통 (로컬 백엔드 + Render 백엔드) ----------
JWT_SECRET_KEY=change-me-in-production
ADMIN_SECRET_KEY=change-me-admin-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 데이터베이스 (TiDB / MySQL). 미설정 시 Mock 데이터로 동작
DATABASE_URL=

# Google Gemini API (이미지 진단·AI 상담). 미설정 시 Mock 진단으로 동작
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OAuth (선택)
GOOGLE_CLIENT_ID=
NAVER_CLIENT_ID=
KAKAO_CLIENT_ID=

# CORS 허용 도메인 (쉼표 구분)
CORS_ORIGINS=http://localhost:5173,https://farmpick.netlify.app,https://farmpick.onrender.com

# ---------- 로컬 개발 전용 ----------
PORT=8000

# ---------- 프론트엔드 (로컬 .env + Netlify/Render 대시보드) ----------
# Netlify 데모와 Render Static Site 대시보드에도 동일하게 등록
VITE_API_BASE_URL=http://localhost:8000
# VITE_API_BASE_URL=https://farmpick-api.onrender.com
